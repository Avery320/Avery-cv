---
import BaseLayout from "../../layouts/BaseLayout.astro";
import FeaturedProjectCard from "./FeaturedProjectCard.astro";
import { getPortfolioPageResources, type FeaturedProject } from "../../data/projects";
import { getLocale } from "../../lib/i18n";
import { getContentSlug, getLocalizedEntries, type PortfolioCollection } from "../../lib/portfolio";

const { collection, route, title, activeItemID } = Astro.props as {
  collection: PortfolioCollection;
  route: string;
  title: string;
  activeItemID: string;
};
const locale = getLocale(Astro.currentLocale);
const projects: FeaturedProject[] = (await getLocalizedEntries(collection, locale))
  .filter((entry) => !entry.data.hidden)
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => {
    const slug = getContentSlug(entry.slug);
    const detailPath = `${route}/${slug}`;

    return {
      id: slug,
      title: entry.data.title,
      description: entry.data.description,
      detailPath,
      image: entry.data.cover ?? "post_img.webp",
      resources: getPortfolioPageResources(detailPath),
    };
  });
---

<BaseLayout title={title} sideBarActiveItemID={activeItemID}>
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">{title}</div>
  </div>

  {
    projects.map((project, index) => (
      <>
        <FeaturedProjectCard project={project} locale={locale} />
        {index < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>

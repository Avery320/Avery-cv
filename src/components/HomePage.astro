---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "./HorizontalCard.astro";
import { getLocale, localizedPath } from "../lib/i18n";
import { withBase } from "../lib/sitePath";

const locale = getLocale(Astro.currentLocale);
const robosimImage = withBase("images/robotics/robosim/cover.png");
const ghRos2Image = withBase("images/robotics/gh-ros2/cover.jpg");
const pageLinks = [
  { label: "CV", path: "cv" },
  { label: "Projects", path: "projects" },
  { label: "Robotics", path: "robotics" },
  { label: "Architecture", path: "architecture" },
  { label: "Fabrication", path: "fabrication" },
  { label: "ParametricDesign", path: "paramtric-design" },
];
const pageLinksLabel = locale === "en" ? "Portfolio pages" : "作品頁面";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Avery.</div>
    <div class="text-3xl py-3 font-bold">Architecture and Robotics Developer</div>
    <div class="py-2">
      <p class="text-lg">
        Focused on architectural digitalization, robotics systems, and design-to-fabrication workflows.
      </p>
    </div>
    <nav class="mt-8 flex flex-wrap gap-2" aria-label={pageLinksLabel}>
      {
        pageLinks.map(({ label, path }) => (
          <a
            class="btn btn-sm transition-colors duration-200 hover:border-primary hover:bg-primary hover:text-primary-content focus-visible:border-primary focus-visible:bg-primary focus-visible:text-primary-content"
            href={localizedPath(path, locale)}
          >
            {label}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>

  <HorizontalCard
    title="RoboSim"
    img={robosimImage}
    desc="Human-Computer Interface | ROS | Robotics | Grasshopper"
    url={localizedPath("robotics/robosim", locale)}
    target="_self"
  />
  <div class="divider my-0"></div>
  <HorizontalCard
    title="gh-ros2"
    img={ghRos2Image}
    desc="Grasshopper Plugin | ROS"
    url={localizedPath("robotics/gh-ros2", locale)}
    target="_self"
  />
</BaseLayout>

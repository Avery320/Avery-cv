---
import { getLocale, localizedPath } from "../lib/i18n";

const { sideBarActiveItemID } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const menuItems = [
  { id: "home", label: "Home", path: "" },
  { id: "projects", label: "Projects", path: "projects" },
  { id: "robotics", label: "Robotics", path: "robotics" },
  { id: "fabrication", label: "Fabrication", path: "fabrication" },
  { id: "paramtric-design", label: "ParamtricDesign", path: "paramtric-design" },
  { id: "cv", label: "CV", path: "cv" },
];
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  {
    menuItems.map(({ id, label, path }) => (
      <li><a class:list={["py-3 text-base", { "bg-base-300": id === sideBarActiveItemID }]} href={localizedPath(path, locale)}>{label}</a></li>
    ))
  }
</ul>

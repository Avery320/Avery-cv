---
import { NAV_ITEMS } from "../config";
import { getLocale, localizedPath } from "../lib/i18n";

const { sideBarActiveItemID } = Astro.props;
const locale = getLocale(Astro.currentLocale);
---

<ul class="menu grow shrink menu-md overflow-y-auto">
  {
    NAV_ITEMS.map(({ id, label, path }) => (
      <li><a class:list={["py-3 text-base", { "bg-base-300": id === sideBarActiveItemID }]} href={localizedPath(path, locale)}>{label}</a></li>
    ))
  }
</ul>

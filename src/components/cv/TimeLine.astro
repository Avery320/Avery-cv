---
const { title, titlePrefix, titleSuffix, subtitle, href, date, description } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-[10px] h-[10px] bg-primary block rounded-full mt-[7px]"></span>
    <span class="education__line bg-primary block h-full w-[2px] translate-x-[4px]"></span>
  </div>
  <div class="experience__data bd-grid px-5">
    <h3 class="text-xl font-bold mb-1">
      {date}｜ <span>{titlePrefix}{href ? <a class="content-link" href={href}>{title}</a> : title}{titleSuffix}</span>
    </h3>
    {subtitle && <span class="font-light text-sm">{subtitle}</span>}
    {
      Array.isArray(description)
        ? <div class="my-2 text-justify">
            {
              description.map((line) => (
                <p class:list={[line.level === "heading" ? "mt-2 font-medium first:mt-0" : "pl-5 font-light text-sm"]}>
                  {line.text}
                </p>
              ))
            }
          </div>
        : description && <p class="my-2 text-justify">{description}</p>
    }
  </div>
</div>

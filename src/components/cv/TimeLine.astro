---
const { title, subtitle, href, date } = Astro.props;
---

<div class="flex">
  <div class="education__time">
    <span class="w-[10px] h-[10px] bg-primary block rounded-full mt-[7px]"></span>
    <span class="education__line bg-primary block h-full w-[2px] translate-x-[4px]"></span>
  </div>
  <div class="experience__data bd-grid px-5">
    <h3 class="font-semibold mb-1">
      {date && <>{date}｜ </>}
      {
        href
          ? <a class="content-link" href={href}>{title}</a>
          : title
      }
    </h3>
    <span class="font-light text-sm">{subtitle}</span>
    <p class="my-2 text-justify">
      <slot />
    </p>
  </div>
</div>

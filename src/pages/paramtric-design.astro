---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { withBase } from "../lib/sitePath";

const projects = (await getCollection("paramtricDesign"))
  .map((project) => ({
    order: project.data.order,
    title: project.data.title,
    desc: project.data.description,
    img: withBase(project.data.cover ?? "post_img.webp"),
    url: withBase(`paramtric-design/${project.slug}`),
  }))
  .sort((a, b) => a.order - b.order);
---

<BaseLayout title="ParamtricDesign" sideBarActiveItemID="paramtric-design">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">ParamtricDesign</div>
  </div>

  {
    projects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          img={project.img}
          desc={project.desc}
          url={project.url}
          target="_self"
        />
        {index < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>

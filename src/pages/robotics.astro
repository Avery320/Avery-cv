---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { withBase } from "../lib/sitePath";

const projectImage = withBase("post_img.webp");
const migratedProjects = (await getCollection("robotics")).map((project) => ({
  order: project.data.order,
  title: project.data.title,
  desc: project.data.description,
  url: withBase(`robotics/${project.slug}`),
}));

const pendingProjects = [
  {
    order: 3,
    title: "RoboSim Grasshopper Plugin",
    desc: "Grasshopper Plugin｜將 RoboSim API 封裝為 Grasshopper 外掛，讓參數化設計流程能直接連接機器人系統。",
    url: "#",
  },
  {
    order: 8,
    title: "Robotic Nonplanar Printing",
    desc: "Python 與 Grasshopper 非平面切片演算法｜支援機械手臂增材製造。",
    url: "#",
  },
];

const projects = [...migratedProjects, ...pendingProjects].sort((a, b) => a.order - b.order);
---

<BaseLayout title="Robotics" sideBarActiveItemID="robotics">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Robotics</div>
  </div>

  {
    projects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          img={projectImage}
          desc={project.desc}
          url={project.url}
          target="_self"
        />
        {index < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>

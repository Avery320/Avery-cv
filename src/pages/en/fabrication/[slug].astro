---
import PortfolioDetailPage from "../../../components/portfolio/PortfolioDetailPage.astro";
import { getLocalizedContentPaths } from "../../../lib/portfolio";

export async function getStaticPaths() {
  return getLocalizedContentPaths("fabrication", "en");
}

const { entry } = Astro.props;
---

<PortfolioDetailPage entry={entry} sectionTitle="Fabrication" sectionPath="fabrication" activeItemID="fabrication" />

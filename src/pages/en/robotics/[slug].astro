---
import PortfolioDetailPage from "../../../components/portfolio/PortfolioDetailPage.astro";
import { getLocalizedContentPaths } from "../../../lib/portfolio";

export async function getStaticPaths() {
  return getLocalizedContentPaths("robotics", "en");
}

const { entry } = Astro.props;
---

<PortfolioDetailPage entry={entry} sectionTitle="Robotics" sectionPath="robotics" activeItemID="robotics" />

---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { withBase } from "../lib/sitePath";

const projectImage = withBase("post_img.webp");
const migratedProjects = (await getCollection("projects")).map((project) => ({
  order: project.data.order,
  title: project.data.title,
  desc: project.data.description,
  img: project.data.cover ?? projectImage,
  url: withBase(`projects/${project.slug}`),
}));

const pendingProjects = [
  {
    order: 2,
    title: "台中大河里福德祠",
    desc: "戴育澤建築師事務所｜以 AR 擴增實境疊合設計模型與現場資訊，協助磁磚放樣與施工定位。",
    img: projectImage,
    url: "#",
  },
];

const projects = [...migratedProjects, ...pendingProjects].sort((a, b) => a.order - b.order);
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div class="mb-5">
    <div class="text-3xl w-full font-bold">Projects</div>
  </div>

  {
    projects.map((project, index) => (
      <>
        <HorizontalCard
          title={project.title}
          img={project.img}
          desc={project.desc}
          url={project.url}
          target="_self"
        />
        {index < projects.length - 1 && <div class="divider my-0" />}
      </>
    ))
  }
</BaseLayout>

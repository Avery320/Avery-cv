---
import PortfolioDetailPage from "../../components/portfolio/PortfolioDetailPage.astro";
import { getLocalizedContentPaths } from "../../lib/portfolio";

export async function getStaticPaths() {
  return getLocalizedContentPaths("projects", "zh-TW");
}

const { entry } = Astro.props;
---

<PortfolioDetailPage entry={entry} sectionTitle="Projects" sectionPath="projects" activeItemID="projects" />
